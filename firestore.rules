rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    match /msgs/{id} {
      allow read: if true;
      allow create: if request.resource.data.text is string && request.resource.data.text.size() < 300;
    }
    match /posts/{id} {
      allow read: if true;
      allow create: if request.resource.data.text is string && request.resource.data.text.size() < 3000;
    }
  }
}
